post_install() {
  cat <<'MSG'
==> bluetooth-disable-ll-privacy: DKMS builds the patched bluetooth module for the installed "linux" kernel at
    the end of this transaction (needs network). It is used after a reboot.
    Check with: dkms status bluetooth-disable-ll-privacy
MSG
}
post_upgrade() { post_install; }
post_remove() {
  echo '==> bluetooth-disable-ll-privacy: the stock bluetooth module is back after a reboot.'
}
